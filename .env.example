# PostgreSQL (primary source of truth). Local Docker Compose default shown.
DATABASE_URL="postgresql://physical:physical_local_only@localhost:5433/physical_bgc?schema=public"

# Used to HMAC-hash registration lookups / session tokens. Generate: openssl rand -base64 48
APP_SECRET="change-me-generate-a-long-random-string"

# Public base URL (used in QR codes / absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed only: password for LOCAL development accounts. Never seed in production.
SEED_DEV_PASSWORD="local-dev-only-ChangeMe1"

# Separate database used only by `npm test` (created by `npm run test:db`).
TEST_DATABASE_URL="postgresql://physical:physical_local_only@localhost:5433/physical_bgc_test?schema=public"

# ── Supabase (production) ──
# DATABASE_URL = pooled "Transaction pooler" string (port 6543) for the running app.
# DIRECT_URL   = "Direct connection" or "Session pooler" string (port 5432). REQUIRED on Supabase:
#                Prisma migrations and the real-time LISTEN connection cannot use the transaction pooler.
# Locally with Docker, leave DIRECT_URL unset.
# DIRECT_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
